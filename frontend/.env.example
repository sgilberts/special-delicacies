VITE_API_BASE_URL=https://api.example.com/api/v1
VITE_BROADCAST_DRIVER=reverb
VITE_REVERB_APP_KEY=replace-with-backend-reverb-app-key
VITE_REVERB_HOST=ws.example.com
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https
# For a hosted Pusher-compatible service use VITE_BROADCAST_DRIVER=pusher and set:
# VITE_PUSHER_APP_KEY=
# VITE_PUSHER_APP_CLUSTER=
